{
  "target_id": "YOUR_CAFE_SLUG:YOUR_BOARD",
  "login_url": "https://cafe.daangn.com/",
  "login_button": "button[data-track-event=\"web_clicked_communityCafe_cafeCommon_gnbLoginButton\"]:visible",
  "write_url": "https://cafe.daangn.com/YOUR_CAFE_SLUG/posts/new",
  "authenticated": "button[aria-label=\"사용자 메뉴\"]:visible",
  "title": "input[placeholder=\"제목을 입력해주세요.\"]",
  "body": "div[contenteditable=\"true\"]:visible",
  "image_input": "input[type=\"file\"][accept^=\"image/\"]",
  "images_ready": "div[contenteditable=\"true\"]:visible img[src^=\"https://\"]",
  "submit": "main button:text-is(\"글쓰기\"):visible >> nth=0",
  "confirm_buttons": [],
  "success": "main h1:visible",
  "login_url_pattern": "^https://accounts\\.daangn\\.com/",
  "login_indicator": "button[data-track-event=\"web_clicked_communityCafe_cafeCommon_gnbLoginButton\"]:visible",
  "blocked_indicator": null,
  "watch_hosts": [],
  "interval_seconds": 30,
  "timeout_ms": 30000,
  "max_attempts": 3,
  "retry_delay_seconds": 10,
  "success_url_pattern": "^https://cafe\\.daangn\\.com/YOUR_CAFE_SLUG/posts/(?!new(?:[/?#]|$))[^/?#]+(?:[/?#]|$)",
  "success_title_matches": true,
  "board_selector": "main button:has-text(\"자유 게시판\"):visible",
  "images_ready_count_matches": true,
  "post_footer": "",
  "interval_min_seconds": 30,
  "interval_max_seconds": 60,
  "min_body_characters": 200,
  "max_title_characters": 50,
  "strip_sources_and_links": false,
  "include_images": false,
  "bulk_workers": 10,
  "bulk_interval_min_seconds": 1,
  "bulk_interval_max_seconds": 3,
  "bulk_checkpoint_every": 10,
  "image_position": "start",
  "editor_settle_ms": 500,
  "board_picker": "main button:has(> span.t5-regular):visible",
  "board_option": "button[role=\"option\"]:has-text(\"자유 게시판\"):visible"
}
