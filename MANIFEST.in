include README.md LICENSE SECURITY.md CONTRIBUTING.md
include pyproject.toml requirements.txt config.example.json .gitignore .gitattributes
include examples/posts.json examples/config.generic.json
recursive-include uploader *.py
recursive-include tests test_*.py
exclude tests/test_reserve.py
prune scripts
include scripts/release.py
include .github/workflows/ci.yml
prune .auth
prune .state
prune .venv
prune .browsers
prune assets
prune content
prune dist
exclude config.json posts.json posts.csv
global-exclude __pycache__ *.py[cod] .DS_Store *.sqlite3 *.sqlite3-journal
