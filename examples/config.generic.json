{
  "target_id": "YOUR_ACCOUNT:YOUR_SITE:YOUR_BOARD",
  "login_url": "https://example.com/login",
  "write_url": "https://example.com/posts/new",
  "authenticated": "[data-testid='account-menu']",
  "title": "input[name='title']",
  "body": "textarea[name='body']",
  "submit": "button[type='submit']",
  "success": "h1.post-title",
  "success_url_pattern": "^https://example\\.com/posts/(?!new$)[^/?#]+",
  "success_title_matches": true,
  "login_url_pattern": "^https://example\\.com/login",
  "login_indicator": "[data-testid='login-button']",
  "watch_hosts": [],
  "interval_seconds": 30,
  "interval_min_seconds": 30,
  "interval_max_seconds": 60,
  "timeout_ms": 30000,
  "max_attempts": 3,
  "retry_delay_seconds": 10,
  "min_body_characters": 1,
  "max_title_characters": 100,
  "post_footer": "",
  "strip_sources_and_links": false,
  "include_images": false,
  "bulk_workers": 3,
  "bulk_interval_min_seconds": 10,
  "bulk_interval_max_seconds": 20,
  "bulk_checkpoint_every": 10,
  "editor_settle_ms": 500,
  "verification": {
    "body": ".post-body",
    "verify_feed": false
  }
}
